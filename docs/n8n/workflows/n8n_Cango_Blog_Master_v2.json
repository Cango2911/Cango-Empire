    {
      "parameters": {
        "jsCode": "// Sicherer WP-Post-Body: HTML-Content korrekt escapen\nconst raw = $input.item.json;\nconst content = raw.message?.content || raw.choices?.[0]?.message?.content || raw.text || raw.output || (raw.json && raw.json.content) || '';\nconst h1Match = content.match(/<h1[^>]*>([^<]+)<\\/h1>/i);\nconst title = h1Match ? h1Match[1].trim() : 'Karriere — ' + new Date().toLocaleDateString('de-DE');\nreturn [{ json: { title, content, nische: 'Karriere' } }];"
