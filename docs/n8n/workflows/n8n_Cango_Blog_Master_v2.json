    {
      "parameters": {
        "jsCode": "// Aggregiert alle 6 WP-Ergebnisse — nach Merge Append; feuert EINMAL\nconst items = $input.all();\nfunction wpTitle(j) {\n  const t = j.title;\n  if (t && typeof t === 'object' && t.rendered) return String(t.rendered).replace(/<[^>]+>/g, '').trim();\n  if (typeof t === 'string') return t;\n  return '—';\n}\nconst titles = items.map(i => wpTitle(i.json)).join('\\n• ');\nconst successCount = items.filter(i => i.json.id != null && i.json.id !== '').length;\nreturn [{\n  json: {\n    successCount,\n    totalCount: items.length,\n    titles,\n    datum: new Date().toLocaleDateString('de-DE'),\n    uhrzeit: new Date().toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' })\n  }\n}];"
      },
