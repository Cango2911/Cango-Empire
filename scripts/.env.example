# CanGo App Empire — Umgebungsvariablen (Vorlage)
# Kopiere diese Datei als .env und fülle die Werte aus.

# Google Maps API (für outreach_sniper.py)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# n8n Webhooks
N8N_WEBHOOK_URL=https://n8n.deine-domain.de/webhook/outreach-leads
N8N_BLOCK_SIGNAL_URL=https://n8n.deine-domain.de/webhook/cango-blocks
N8N_JARVIS_WEBHOOK=https://n8n.deine-domain.de/webhook/jarvis-analyze
N8N_TASK_CONFIRM_WEBHOOK=https://n8n.deine-domain.de/webhook/task-confirm

# Supabase (Projekt-URL + anon key)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini (Google AI Studio · kostenlos · aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bots
# @Cango_master_bot — alter Bot (Eskalation, Avatar-Pipeline)
TELEGRAM_BOT_TOKEN_OLD=your_old_bot_token_here
# @CanGo_ToDo_Master_bot — neuer dedizierter Jarvis-Bot
TELEGRAM_BOT_TOKEN=your_new_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenAI (optional — für Whisper Voice-to-Text)
# Alternative: lokaler Whisper auf Hostinger VPS (kostenlos)
OPENAI_API_KEY=your_openai_api_key_here

# Google Sheets (Agency Funnel Sync)
GSHEETS_SERVICE_ACCOUNT_JSON=/Users/canberkkivilcim/cango-gsheets-service-account.json
