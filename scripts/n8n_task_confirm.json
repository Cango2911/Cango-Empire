{
  "name": "CanGo · Jarvis Task-Queue (Start/Skip/Done + Micro-Step)",
  "nodes": [

    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1-5" }] },
        "options": {}
      },
      "id": "cron-morning-push",
      "name": "Cron Mo–Fr 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "notes": "Täglich 08:00 – Jarvis pusht proaktiv. Kein Dashboard nötig."
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/jarvis_missions?select=missions,daily_focus,context&date=eq.{{ $now.format('YYYY-MM-DD') }}&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-todays-missions",
      "name": "Supabase: Heutige Missions laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json?.[0];\nconst raw = row?.missions;\nconst missions = typeof raw === 'string' ? JSON.parse(raw) : (raw || []);\nconst ctx = typeof row?.context === 'string' ? JSON.parse(row?.context || '{}') : (row?.context || {});\n\n// Fallback wenn keine Jarvis-Mission\nconst defaultMission = {\n  rank: 1,\n  task: '1 Mittelständler via LinkedIn oder E-Mail kontaktieren',\n  pillar: 'Coaching',\n  why: 'Kein Jarvis-Eintrag für heute. Default-Mission: Outreach ist immer richtig.',\n  tools: ['BrowserAct', 'outreach_sniper.py']\n};\n\nconst queue = missions.length ? missions.slice(0, 5) : [defaultMission];\n\nreturn [{ json: {\n  queue,\n  currentIdx: 0,\n  energyLevel: ctx.energyLevel || 7,\n  deepRest: ctx.deepRestNeeded || false,\n  totalMissions: queue.length,\n  date: new Date().toISOString().split('T')[0]\n}}];"
      },
      "id": "build-queue",
      "name": "Queue aufbauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300],
      "notes": "Baut Task-Queue aus Jarvis-Missions. Fallback bei leerem Ergebnis."
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.deepRest ? '🛡️ *Deep-Rest-Tag* – nur eine einzige Aufgabe heute:' : '🎯 *Aufgabe ' + ($json.currentIdx + 1) + ' von ' + $json.totalMissions + ':*' }}\n\n`{{ $json.queue[0].task }}`\n\n📋 _{{ $json.queue[0].why }}_\n🔧 {{ $json.queue[0].tools?.join(' · ') || '' }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": {
            "inline_keyboard": [[
              { "text": "▶ Starten",   "callback_data": "start_0" },
              { "text": "⏩ Skippen",  "callback_data": "skip_0" },
              { "text": "✅ Erledigt", "callback_data": "done_0" }
            ], [
              { "text": "⚡ Energie low – weniger Tasks", "callback_data": "low_energy" }
            ]]
          }
        }
      },
      "id": "tg-send-first-task",
      "name": "Telegram: Erste Aufgabe senden",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [960, 300],
      "notes": "4 Buttons: Starten / Skippen / Erledigt / Energie-Low. Kein Text nötig."
    },

    {
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "id": "tg-callback-trigger",
      "name": "Telegram: Button-Klick empfangen",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 580],
      "notes": "Empfängt alle Inline-Button Klicks"
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/answerCallbackQuery",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"callback_query_id\": \"{{ $json.callback_query.id }}\" }",
        "options": {}
      },
      "id": "answer-callback",
      "name": "Telegram: Callback bestätigen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 580],
      "notes": "Pflicht: Ohne diese Antwort bleibt der Button im Lade-Zustand (dreht sich)"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Telegram: Button-Klick empfangen').item.json.callback_query?.data || '';\nconst idx  = parseInt(data.split('_')[1] ?? 0);\nlet action = 'unknown';\nif (data.startsWith('start_'))    action = 'start';\nelse if (data.startsWith('done_')) action = 'done';\nelse if (data.startsWith('skip_')) action = 'skip';\nelse if (data === 'low_energy')    action = 'low';\nelse if (data.startsWith('micro_'))action = 'micro_done';\nreturn [{ json: { action, idx, raw: data } }];"
      },
      "id": "parse-action",
      "name": "Action + Index parsen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 580]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "start", "operator": { "type": "string", "operation": "equals" } }] } },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "done",  "operator": { "type": "string", "operation": "equals" } }] } },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "skip",  "operator": { "type": "string", "operation": "equals" } }] } },
            { "conditions": { "options": {}, "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "low",   "operator": { "type": "string", "operation": "equals" } }] } }
          ]
        },
        "options": {}
      },
      "id": "router",
      "name": "Router: Start / Done / Skip / Low",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [960, 580],
      "notes": "Output 0=Start · 1=Done · 2=Skip · 3=Low"
    },

    {
      "parameters": {
        "operation": "upsert",
        "schema": { "__rl": true, "value": "public", "mode": "list" },
        "table": { "__rl": true, "value": "task_confirmations", "mode": "list" },
        "columns": {
          "mappingMode": "defineBelow",
          "values": [
            { "column": "date",       "value": "={{ $now.format('YYYY-MM-DD') }}" },
            { "column": "task_rank",  "value": "={{ $('Action + Index parsen').item.json.idx + 1 }}" },
            { "column": "status",     "value": "active" },
            { "column": "started_at", "value": "={{ $now }}" }
          ]
        },
        "matchingColumns": ["date", "task_rank"]
      },
      "id": "supabase-log-start",
      "name": "Supabase: Start loggen",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1200, 460]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚀 *Deep-Work-Modus aktiv*\nTimer gestartet: {{ $now.format('HH:mm') }} Uhr\n\n_Handy weglegen. Fokus. Jarvis meldet sich in 45 Minuten._\n\n━━━━━━━━━━━━━━━\n_Der einzige Job jetzt: Anfangen._",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "tg-start-confirm",
      "name": "Telegram: Deep-Work bestätigen",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1440, 460]
    },
    {
      "parameters": { "amount": 45, "unit": "minutes" },
      "id": "wait-45min",
      "name": "Warten: 45 Minuten",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1680, 460],
      "notes": "n8n wartet 45 Min. dann Check-in"
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/task_confirmations?date=eq.{{ $now.format('YYYY-MM-DD') }}&task_rank=eq.{{ $('Action + Index parsen').item.json.idx + 1 }}&select=status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "check-if-done",
      "name": "Supabase: Noch offen?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json[0]?.status }}",
              "rightValue": "active",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "id": "filter-still-active",
      "name": "Filter: Noch active?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [2160, 460]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⏱️ *45 Minuten vorbei.*\n\nWie läuft's?",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": {
            "inline_keyboard": [[
              { "text": "✅ Erledigt!", "callback_data": "done_{{ $('Action + Index parsen').item.json.idx }}" },
              { "text": "⏩ Brauche mehr Zeit", "callback_data": "skip_{{ $('Action + Index parsen').item.json.idx }}" }
            ]]
          }
        }
      },
      "id": "tg-checkin",
      "name": "Telegram: 45-Min Check-in",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [2400, 460]
    },

    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/task_confirmations?date=eq.{{ $now.format('YYYY-MM-DD') }}&task_rank=eq.{{ $('Action + Index parsen').item.json.idx + 1 }}&select=skip_count",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-skip-count",
      "name": "Supabase: Skip-Count laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 700],
      "notes": "Liest wie oft diese Aufgabe heute schon geskippt wurde"
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json?.[0];\nconst skipCount = (row?.skip_count || 0) + 1;\nconst isMicroStep = skipCount >= 3;\nreturn [{ json: { skipCount, isMicroStep } }];"
      },
      "id": "calc-skip",
      "name": "Skip-Count berechnen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 700]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": { "__rl": true, "value": "public", "mode": "list" },
        "table": { "__rl": true, "value": "task_confirmations", "mode": "list" },
        "columns": {
          "mappingMode": "defineBelow",
          "values": [
            { "column": "date",       "value": "={{ $now.format('YYYY-MM-DD') }}" },
            { "column": "task_rank",  "value": "={{ $('Action + Index parsen').item.json.idx + 1 }}" },
            { "column": "status",     "value": "skipped" },
            { "column": "skip_count", "value": "={{ $json.skipCount }}" }
          ]
        },
        "matchingColumns": ["date", "task_rank"]
      },
      "id": "supabase-log-skip",
      "name": "Supabase: Skip loggen",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1680, 700]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $('Calc-Skip berechnen').item.json.isMicroStep }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "filter-micro-step",
      "name": "Filter: Micro-Step nötig?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [1920, 700]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔬 *3× geskippt. Jarvis fragt jetzt anders:*\n\nVergiss die Aufgabe.\n\n*Was ist der KLEINSTE, lächerlichste Schritt,\nnur um anzufangen?*\n\nNicht die Aufgabe erledigen.\nNur: Datei öffnen. Browser öffnen. Ersten Satz schreiben. Telefon in die Hand nehmen.\n\n_Der erste Millimeter. Mehr nicht._",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": {
            "inline_keyboard": [[
              { "text": "✅ Gemacht (1 Min.)", "callback_data": "micro_{{ $('Action + Index parsen').item.json.idx }}" },
              { "text": "😮‍💨 Heute nicht mehr", "callback_data": "skip_day" }
            ]]
          }
        }
      },
      "id": "tg-micro-step",
      "name": "Telegram: Micro-Step Challenge",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [2160, 620],
      "notes": "Nach 3× Skip: Keine Aufgabe mehr, nur noch der kleinste mögliche Schritt"
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⏩ *Geskippt* ({{ $('Calc-Skip berechnen').item.json.skipCount }}/3)\n\n_Kein Problem. Aufgabe kommt in 2 Stunden zurück._\n\nJetzt: kurze Pause oder nächste Mission?",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": {
            "inline_keyboard": [[
              { "text": "➡️ Nächste Mission", "callback_data": "done_{{ $('Action + Index parsen').item.json.idx }}" },
              { "text": "☕ Pause (30 Min.)",  "callback_data": "skip_day" }
            ]]
          }
        }
      },
      "id": "tg-skip-normal",
      "name": "Telegram: Normaler Skip",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [2160, 780]
    },

    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/task_confirmations?date=eq.{{ $now.format('YYYY-MM-DD') }}&select=status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-done-count",
      "name": "Supabase: Erledigte heute laden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 940]
    },
    {
      "parameters": {
        "jsCode": "const rows    = $input.first().json || [];\nconst done    = rows.filter(r => r.status === 'completed').length + 1;\nconst total   = 5;\n// 9.9M micro-feedback\nconst target  = 9900000;\n// Jede abgeschlossene Aufgabe = ~€500 Outreach-Potential\nconst perTask = 500;\nconst earned  = done * perTask;\nconst pct     = ((earned / target) * 100).toFixed(4);\nconst streakBonus = done >= 3 ? '🔥 3 Tasks – Streak-Bonus!' : '';\nconst msgs = [\n  `Du bist heute ${pct}% näher an den 9.9M.`,\n  `Jede abgeschlossene Aufgabe = Fundament für 9.9M.`,\n  `${done} Tasks heute. Konstanz schlägt Genie.`,\n  `Das war Aufgabe ${done}. 9.9M ist kein Sprung – es sind Schritte.`\n];\nconst msg = msgs[done % msgs.length];\nreturn [{ json: { done, pct, earned, msg, streakBonus } }];"
      },
      "id": "calc-99m-feedback",
      "name": "9.9M Feedback berechnen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 940],
      "notes": "Berechnet Micro-Fortschritt zum 9.9M Ziel + wählt Motivations-Nachricht"
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": { "__rl": true, "value": "public", "mode": "list" },
        "table": { "__rl": true, "value": "task_confirmations", "mode": "list" },
        "columns": {
          "mappingMode": "defineBelow",
          "values": [
            { "column": "date",         "value": "={{ $now.format('YYYY-MM-DD') }}" },
            { "column": "task_rank",    "value": "={{ $('Action + Index parsen').item.json.idx + 1 }}" },
            { "column": "status",       "value": "completed" },
            { "column": "completed_at", "value": "={{ $now }}" }
          ]
        },
        "matchingColumns": ["date", "task_rank"]
      },
      "id": "supabase-log-done",
      "name": "Supabase: Erledigt loggen",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1680, 940]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ *+1!*\n\n{{ $('9.9M Feedback berechnen').item.json.msg }}\n{{ $('9.9M Feedback berechnen').item.json.streakBonus }}\n\n📊 Heute erledigt: *{{ $('9.9M Feedback berechnen').item.json.done }} Tasks*\n💰 Aufgebaut: ~€{{ $('9.9M Feedback berechnen').item.json.earned }}\n📈 9.9M Delta: *{{ $('9.9M Feedback berechnen').item.json.pct }}% heute drangearbeitet*\n\n_Nächste Aufgabe kommt gleich…_",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "tg-done-feedback",
      "name": "Telegram: Done + 9.9M Feedback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1920, 940],
      "notes": "Dopamin-Kick: sofortiges 9.9M-Feedback. Macht das Erledigen messbar und bedeutsam."
    },
    {
      "parameters": { "amount": 5, "unit": "seconds" },
      "id": "wait-next-task",
      "name": "Warten: 5 Sekunden",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [2160, 940]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/jarvis_missions?select=missions&date=eq.{{ $now.format('YYYY-MM-DD') }}&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-next-mission",
      "name": "Supabase: Nächste Mission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 940]
    },
    {
      "parameters": {
        "jsCode": "const doneIdx  = $('Action + Index parsen').item.json.idx;\nconst nextIdx  = doneIdx + 1;\nconst row      = $input.first().json?.[0];\nconst raw      = row?.missions;\nconst missions = typeof raw === 'string' ? JSON.parse(raw) : (raw || []);\nif (nextIdx >= missions.length) {\n  return [{ json: { allDone: true, total: missions.length } }];\n}\nreturn [{ json: { allDone: false, mission: missions[nextIdx], nextIdx } }];"
      },
      "id": "extract-next-mission",
      "name": "Nächste Mission extrahieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 940]
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "leftValue": "={{ $json.allDone }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "filter-has-next",
      "name": "Filter: Noch eine Mission?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [2880, 940]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🎯 *Aufgabe {{ $json.nextIdx + 1 }}:*\n\n`{{ $json.mission.task }}`\n\n📋 _{{ $json.mission.why }}_\n🔧 {{ $json.mission.tools?.join(' · ') || '' }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": {
            "inline_keyboard": [[
              { "text": "▶ Starten",   "callback_data": "start_{{ $json.nextIdx }}" },
              { "text": "⏩ Skippen",  "callback_data": "skip_{{ $json.nextIdx }}" },
              { "text": "✅ Erledigt", "callback_data": "done_{{ $json.nextIdx }}" }
            ]]
          }
        }
      },
      "id": "tg-send-next-task",
      "name": "Telegram: Nächste Aufgabe senden",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [3120, 900]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🏆 *Alle {{ $json.total }} Missions erledigt!*\n\nJarvis ist stolz.\n\n_9.9M wartet nicht — du auch nicht.\nHeute hast du Fundament gelegt._\n\n🌙 Triff dein Abend-Review um 18:00 Uhr.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "tg-all-done",
      "name": "Telegram: Alle erledigt",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [3120, 1020]
    },

    {
      "parameters": {
        "operation": "upsert",
        "schema": { "__rl": true, "value": "public", "mode": "list" },
        "table": { "__rl": true, "value": "jarvis_missions", "mode": "list" },
        "columns": {
          "mappingMode": "defineBelow",
          "values": [
            { "column": "date", "value": "={{ $now.format('YYYY-MM-DD') }}" },
            {
              "column": "context",
              "value": "={{ JSON.stringify({ energyLevel: 2, moodCheck: false, deepRestNeeded: true, source: 'telegram_low_button', updatedAt: $now }) }}"
            }
          ]
        },
        "matchingColumns": ["date"]
