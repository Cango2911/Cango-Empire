# ============================================================
# CanGo Empire – Umgebungsvariablen
# Kopiere diese Datei als .env auf den VPS: /opt/cango/.env
# .env ist in .gitignore – niemals committen!
# ============================================================

# ── Depositphotos Enterprise API (loginEnterprise) ─────────
# WICHTIG: DP_USER = Benutzername für dp_login_user — nicht die E-Mail.
DP_API_KEY=
DP_USER=
DP_PASS=
# optional (nur Referenz / Lizenz-IDs aus dem Enterprise-Portal):
# DP_EMAIL=
# DP_LICENSE_DIGITAL=50976
# DP_LICENSE_ENTERPRISE=50978
# DP_LICENSE_AI=50980

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Slack (für n8n Webhook-Benachrichtigungen) ───────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── VPS Pfade ────────────────────────────────────────────────
# Referenz: Live-Website läuft im Container cango-empire-website;
# Host-Pfad für statische Dateien (gleiches Ziel wie CANGO_SSH_WWW):
CANGO_WWW_ROOT=/opt/cango-empire-website/website

# Verzeichnis für das blog_generator.py Skript auf dem VPS
CANGO_SCRIPT_DIR=/opt/cango

# ── Deploy per SSH + rsync (empfohlen statt FTP) ──────────────
# Hostinger VPS: SSH oft nur auf 2222 (Port 22 kann gesperrt sein):
#   ssh -p 2222 root@31.97.56.197
#   ./scripts/deploy_rsync_vps.sh
CANGO_SSH_HOST=31.97.56.197
CANGO_SSH_PORT=2222
CANGO_SSH_USER=root
# Ziel auf dem VPS (Host-Pfad, den der Container cango-empire-website einbindet)
CANGO_SSH_WWW=/opt/cango-empire-website/website

# ── FTP (Fallback, wenn kein SSH) ────────────────────────────
FTP_HOST=145.223.115.121
FTP_USER=u447057499.automation-cango-app-empire.com
FTP_PASS=DEIN_FTP_PASSWORT

# ── Pexels (nur fetch-blog-images.py) ───────────────────────
PEXELS_API_KEY=
