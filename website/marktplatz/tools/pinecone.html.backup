  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-container">
      <div class="hero-content">
        <div class="badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
          AUTOMATION
        </div>
        <h1 class="hero-title">
          <span>Make</span><br>
          Visuelle Automation
        </h1>
        <p class="hero-description">
          Die leistungsstärkste visuelle Automation-Plattform. Verbinde 1000+ Apps, erstelle komplexe Workflows ohne Code und automatisiere alles.
        </p>
        <div class="hero-meta">
          <div class="meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
            Ab 9€/Monat
          </div>
          <div class="meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
            1000+ Integrationen
          </div>
          <div class="meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
            </svg>
            No-Code
          </div>
        </div>
        <div class="hero-buttons">
          <a href="#pricing" class="btn btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Kostenlos testen
          </a>
          <a href="#video" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            Video ansehen
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="tool-logo-container">
          <img src="https://cdn.simpleicons.org/make/6D29D9" alt="Make Logo" class="tool-logo">
        </div>
      </div>
    </div>
  </section>

  <!-- Video Section -->
  <section class="video-section" id="video">
    <div class="section-container">
      <div class="section-header">
        <p class="section-label">Erklärvideo</p>
        <h2 class="section-title">Make in Aktion</h2>
        <p class="section-subtitle">Erfahre, wie du mit Make komplexe Automationen ohne Programmierung erstellst.</p>
      </div>
      <div class="video-wrapper">
        <div class="video-placeholder" onclick="loadVideo(this, 'VIDEO_ID_HIER')">
          <div class="play-button">
            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
          <p>Klicken um Video zu laden</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="section-container">
      <div class="section-header">
        <p class="section-label">Features</p>
        <h2 class="section-title">Was macht Make besonders?</h2>
        <p class="section-subtitle">Entdecke die Vorteile der visuellen Automation-Plattform.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <h3 class="feature-title">Visueller Editor</h3>
          <p class="feature-description">Drag-and-Drop Interface für komplexe Workflows. Keine Programmierkenntnisse nötig.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </div>
          <h3 class="feature-title">1000+ Apps</h3>
          <p class="feature-description">Verbinde Google, Slack, Shopify, Notion und hunderte weitere Apps.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <h3 class="feature-title">HTTP/API Module</h3>
          <p class="feature-description">Verbinde jede API – auch ohne native Integration. Volle Flexibilität.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="feature-title">Router & Filter</h3>
          <p class="feature-description">Verzweige Workflows mit Bedingungen. Komplexe Logik leicht umgesetzt.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
