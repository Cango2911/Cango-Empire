    // Affiliate Link Tracking & Redirect
    function trackAffiliate(toolId) {
      const affiliateConfig = AFFILIATE_LINKS[toolId];
      
      if (!affiliateConfig) {
        console.error('Affiliate-Link nicht gefunden:', toolId);
        return false;
      }

      // Event Tracking (Google Analytics / GTM)
      if (typeof gtag !== 'undefined') {
        gtag('event', 'affiliate_click', {
          'affiliate_id': toolId,
          'affiliate_name': affiliateConfig.provider,
          'affiliate_type': affiliateConfig.type,
          'event_category': 'Affiliate',
          'event_label': toolId
        });
      }

      // Console Log für Debugging
      console.log('Affiliate Click:', {
        tool: toolId,
        provider: affiliateConfig.provider,
        type: affiliateConfig.type,
        url: affiliateConfig.url
      });

      // Link öffnen (in neuem Tab)
      if (affiliateConfig.url && affiliateConfig.url !== '#') {
        window.open(affiliateConfig.url, '_blank', 'noopener,noreferrer');
        return true;
      } else {
        // Fallback wenn Link noch nicht eingetragen
        console.warn('Affiliate-Link für ' + toolId + ' noch nicht konfiguriert. Bitte in AFFILIATE_LINKS eintragen.');
        // Kein Alert mehr - einfach in Console loggen, damit User-Experience nicht gestört wird
        return false;
      }
    }
    
    // Funktion zum einfachen Eintragen neuer Affiliate-Links
    function updateAffiliateLink(toolId, url, type = 'direct') {
      if (AFFILIATE_LINKS[toolId]) {
        AFFILIATE_LINKS[toolId].url = url;
        AFFILIATE_LINKS[toolId].type = type;
        console.log('Affiliate-Link aktualisiert:', toolId, url);
      } else {
        console.error('Tool nicht gefunden:', toolId);
      }
    }

    // ============================================
    // TOOL FILTER FUNCTION
    // ============================================
    let currentSort = 'name'; // Standard-Sortierung
    let currentSearch = ''; // Aktueller Suchbegriff
    
    function filterTools(category) {
      const tools = document.querySelectorAll('.tool-card');
      const filterButtons = document.querySelectorAll('.filter-btn');
      
      // Update active button
      filterButtons.forEach(btn => {
        if (btn.dataset.category === category) {
          btn.classList.add('active');
          btn.style.background = 'rgba(249, 115, 22, 0.1)';
          btn.style.borderColor = 'rgba(249, 115, 22, 0.3)';
          btn.style.color = 'var(--primary-400)';
        } else {
          btn.classList.remove('active');
          btn.style.background = 'rgba(249, 115, 22, 0.05)';
          btn.style.borderColor = 'rgba(249, 115, 22, 0.2)';
          btn.style.color = 'var(--text-secondary)';
        }
      });
      
      // Filter tools (berücksichtige auch aktuelle Suche)
      tools.forEach(tool => {
        const toolCategories = tool.dataset.category ? tool.dataset.category.split(' ') : [];
        const matchesCategory = category === 'all' || toolCategories.includes(category);
        
        // Prüfe auch Suche
        let matchesSearch = true;
        if (currentSearch) {
          const toolName = tool.querySelector('.tool-card__name').textContent.toLowerCase();
          const toolDescription = tool.querySelector('.tool-card__description').textContent.toLowerCase();
          const toolFeatures = Array.from(tool.querySelectorAll('.tool-card__feature')).map(f => f.textContent.toLowerCase()).join(' ');
          const toolBadge = tool.querySelector('.tool-card__badge')?.textContent.toLowerCase() || '';
          const searchIn = toolName + ' ' + toolDescription + ' ' + toolFeatures + ' ' + toolBadge;
          matchesSearch = searchIn.includes(currentSearch);
        }
        
        if (matchesCategory && matchesSearch) {
          tool.classList.remove('hidden');
          tool.style.display = 'flex';
        } else {
          tool.classList.add('hidden');
          tool.style.display = 'none';
        }
      });
      
      // Sortiere nach aktueller Sortierung
      sortTools(currentSort, false);
      
      // Update Suchergebnisse (nur wenn Suche aktiv)
      if (currentSearch) {
        const visibleTools = Array.from(tools).filter(tool => !tool.classList.contains('hidden'));
        updateSearchResults(visibleTools.length, tools.length);
      } else {
        updateSearchResults(0, 0);
      }
    }

    // ============================================
    // TOOL SORT FUNCTION
    // ============================================
    function sortTools(sortType, updateFilter = true) {
      currentSort = sortType;
      
      const toolsGrid = document.getElementById('toolsGrid');
      const tools = Array.from(document.querySelectorAll('.tool-card'));
      const visibleTools = tools.filter(tool => !tool.classList.contains('hidden'));
      
      // Update sort options im Dropdown
      const sortOptions = document.querySelectorAll('.sort-option');
      sortOptions.forEach(btn => {
        if (btn.dataset.sort === sortType) {
          btn.style.background = 'rgba(249, 115, 22, 0.15)';
          btn.style.color = 'var(--primary-400)';
          btn.style.fontWeight = '600';
        } else {
          btn.style.background = 'transparent';
          btn.style.color = 'var(--text-primary)';
          btn.style.fontWeight = '500';
        }
      });
      
      // Sortiere Tools
      visibleTools.sort((a, b) => {
        switch(sortType) {
          case 'name':
            const nameA = a.querySelector('.tool-card__name').textContent.trim();
            const nameB = b.querySelector('.tool-card__name').textContent.trim();
            return nameA.localeCompare(nameB, 'de', { sensitivity: 'base' });
          
          case 'price-asc':
            return getPriceValue(a) - getPriceValue(b);
          
          case 'price-desc':
            return getPriceValue(b) - getPriceValue(a);
          
          case 'popularity':
            return getPopularity(b) - getPopularity(a);
          
          default:
            return 0;
        }
      });
      
      // Re-append sorted tools
      visibleTools.forEach(tool => {
        toolsGrid.appendChild(tool);
      });
    }
    
    // Hilfsfunktion: Extrahiert Preis-Wert aus Preis-Text
    function getPriceValue(toolCard) {
      const priceElement = toolCard.querySelector('.tool-card__price');
      if (!priceElement) return 999999; // Kein Preis = ganz nach hinten
      
      const priceText = priceElement.textContent.trim();
      
      // Prüfe auf "LIFETIME DEAL" oder "Open Source"
      if (priceText.includes('LIFETIME') || priceText.includes('Lifetime')) return 0;
      if (priceText.includes('Open Source') || priceText.includes('Kostenlos')) return -1;
      
      // Extrahiere Zahl aus Text (z.B. "ab 20$ / Monat" -> 20)
      const match = priceText.match(/(\d+(?:\.\d+)?)/);
      if (match) {
        return parseFloat(match[1]);
      }
      
      return 999999; // Fallback: ganz nach hinten
    }
    
    // Hilfsfunktion: Beliebtheit basierend auf Tool-Name (kann später erweitert werden)
    function getPopularity(toolCard) {
      const toolName = toolCard.querySelector('.tool-card__name').textContent.trim().toLowerCase();
      
      // Beliebtheits-Ranking (höhere Zahl = beliebter)
      const popularityMap = {
        'chatgpt': 100,
        'openai': 100,
        'claude': 95,
        'perplexity': 90,
        'n8n': 85,
        'midjourney': 85,
        'elevenlabs': 80,
        'runway': 80,
        'browseract': 75,
        'notion': 75,
        'cursor': 70,
        'surfer': 70,
        'neuronwriter': 65,
        'depositphotos': 60,
        'hostinger': 55,
      };
      
      // Prüfe ob Tool-Name in Map enthalten ist
      for (const [key, value] of Object.entries(popularityMap)) {
        if (toolName.includes(key)) {
          return value;
        }
      }
      
      // Standard: basierend auf Position in Liste (früher = beliebter)
      return 50;
    }

    // ============================================
    // TOOL SEARCH FUNCTION
    // ============================================
    function searchTools(searchTerm) {
      currentSearch = searchTerm.toLowerCase().trim();
      
      const tools = document.querySelectorAll('.tool-card');
      const toolsGrid = document.getElementById('toolsGrid');
      
      if (!currentSearch) {
        // Wenn Suche leer, zeige alle Tools basierend auf aktuellem Filter
        const activeFilter = document.querySelector('.filter-btn.active');
        if (activeFilter) {
          filterTools(activeFilter.dataset.category);
        }
        return;
      }
      
      // Durchsuche Tools
      let visibleCount = 0;
      tools.forEach(tool => {
        const toolName = tool.querySelector('.tool-card__name').textContent.toLowerCase();
        const toolDescription = tool.querySelector('.tool-card__description').textContent.toLowerCase();
        const toolFeatures = Array.from(tool.querySelectorAll('.tool-card__feature')).map(f => f.textContent.toLowerCase()).join(' ');
        const toolBadge = tool.querySelector('.tool-card__badge')?.textContent.toLowerCase() || '';
        
        // Suche in Name, Beschreibung, Features und Badge
        const searchIn = toolName + ' ' + toolDescription + ' ' + toolFeatures + ' ' + toolBadge;
        
        if (searchIn.includes(currentSearch)) {
          tool.classList.remove('hidden');
          tool.style.display = 'flex';
          visibleCount++;
        } else {
          tool.classList.add('hidden');
          tool.style.display = 'none';
        }
      });
      
      // Sortiere sichtbare Tools
      const visibleTools = Array.from(tools).filter(tool => !tool.classList.contains('hidden'));
      sortTools(currentSort, false);
      
      // Zeige Anzahl der Ergebnisse
      updateSearchResults(visibleCount, tools.length);
    }
    
    // Zeige Anzahl der Suchergebnisse
    function updateSearchResults(visible, total) {
      let resultsInfo = document.getElementById('searchResultsInfo');
      if (!resultsInfo) {
        resultsInfo = document.createElement('div');
        resultsInfo.id = 'searchResultsInfo';
        resultsInfo.style.cssText = 'text-align: center; margin-top: var(--space-4); color: var(--text-secondary); font-size: var(--text-sm);';
        document.querySelector('.tools-search').after(resultsInfo);
      }
      
      if (currentSearch) {
        resultsInfo.textContent = `${visible} von ${total} Tools gefunden`;
        resultsInfo.style.display = 'block';
      } else {
        resultsInfo.style.display = 'none';
      }
    }

    // ============================================
    // SORT DROPDOWN FUNCTIONS
    // ============================================
    function toggleSortDropdown() {
      const dropdown = document.getElementById('sortDropdown');
      const isOpen = dropdown.style.display === 'block';
      dropdown.style.display = isOpen ? 'none' : 'block';
    }
    
    function selectSort(sortType, label) {
      sortTools(sortType);
      document.getElementById('sortDropdown').style.display = 'none';
    }
    
    // Schließe Dropdown wenn außerhalb geklickt wird
    document.addEventListener('click', function(event) {
      const dropdown = document.getElementById('sortDropdown');
      const button = document.getElementById('sortDropdownBtn');
      if (dropdown && button && !dropdown.contains(event.target) && !button.contains(event.target)) {
        dropdown.style.display = 'none';
      }
    });

    // Close mobile menu when clicking a link
    document.querySelectorAll('.nav__link, .nav__cta').forEach(link => {
      link.addEventListener('click', () => {
        document.querySelector('.nav__menu').classList.remove('active');
      });
    });

    // ============================================
    // TOOL LOGOS LADEN
    // ============================================
    function loadToolLogos() {
      const toolCards = document.querySelectorAll('.tool-card');
      toolCards.forEach(card => {
        const toolName = card.querySelector('.tool-card__name')?.textContent.trim();
        const iconDiv = card.querySelector('.tool-card__icon');
        
        if (toolName && iconDiv) {
          const emoji = iconDiv.textContent.trim();
          let logoUrl = TOOL_LOGOS[toolName];
          
          // Debug: Log das Mapping
          if (!logoUrl) {
            console.warn('Kein Logo-Mapping für:', toolName);
          }
          
          // Wenn kein Logo im Mapping, versuche automatische Erkennung
          if (!logoUrl) {
            // Versuche Tool-URL aus Affiliate-Links zu extrahieren
            const toolId = toolName.toLowerCase().replace(/\s+/g, '').replace(/[^a-z0-9]/g, '');
            const affiliateLink = AFFILIATE_LINKS[toolId];
            if (affiliateLink && affiliateLink.url && affiliateLink.url !== '#') {
              try {
                const url = new URL(affiliateLink.url);
                logoUrl = url.origin + '/favicon-192x192.png';
              } catch(e) {
                // URL konnte nicht geparst werden
              }
            }
            
            // Wenn immer noch keine URL, versuche Domain aus Tool-Name
            if (!logoUrl) {
              const domainMatch = toolName.toLowerCase().match(/(\w+)\.(ai|io|com|dev|app|so|co|sh)/);
              if (domainMatch) {
                logoUrl = 'https://' + domainMatch[0] + '/favicon-192x192.png';
              } else {
                const cleanName = toolName.toLowerCase().replace(/\s+/g, '').replace(/[^a-z0-9]/g, '');
                logoUrl = 'https://' + cleanName + '.com/favicon-192x192.png';
              }
            }
          }
          
          if (logoUrl) {
            // Erstelle img Element - Verbessertes Logo-System mit mehreren Quellen
            const img = document.createElement('img');
            img.alt = toolName + ' Logo';
            img.style.display = 'none';
            
            // Extrahiere Domain aus URL für Fallbacks (unterstützt alle URL-Formate)
            let domain = '';
            // Prüfe verschiedene URL-Formate
            const clearbitMatch = logoUrl.match(/logo\.clearbit\.com\/([^?\/]+)/);
            const faviconMatch = logoUrl.match(/https?:\/\/(?:www\.)?([^\/]+)\//);
            const directMatch = logoUrl.match(/https?:\/\/(?:www\.)?([^\/]+)/);
            
            if (clearbitMatch) {
              domain = clearbitMatch[1];
            } else if (faviconMatch) {
              domain = faviconMatch[1];
            } else if (directMatch) {
              domain = directMatch[1];
            }
            
            // Verbessertes Logo-System mit mehreren Quellen
            const logoSources = [];
            
            // Wenn logoUrl bereits eine direkte URL ist, verwende sie zuerst (höchste Priorität)
            if (logoUrl && !logoUrl.includes('logo.clearbit.com') && !logoUrl.includes('google.com/s2/favicons')) {
              logoSources.push(logoUrl);
            }
            
            if (domain) {
              // 1. Direkte Favicon-URLs von der Domain (höchste Qualität - zuerst versuchen)
              logoSources.push(`https://${domain}/favicon-192x192.png`);
              logoSources.push(`https://${domain}/favicon-512x512.png`);
              logoSources.push(`https://${domain}/favicon-32x32.png`);
              logoSources.push(`https://${domain}/favicon.ico`);
              
              // 2. Direkte Logo-URLs von der Domain
              logoSources.push(`https://${domain}/logo.png`);
              logoSources.push(`https://${domain}/assets/logo.png`);
              logoSources.push(`https://${domain}/images/logo.png`);
              logoSources.push(`https://${domain}/static/logo.png`);
              logoSources.push(`https://${domain}/img/logo.png`);
              logoSources.push(`https://${domain}/cdn/logo.png`);
              logoSources.push(`https://${domain}/assets/images/logo.png`);
              
              // 3. Clearbit Logo API (hohe Qualität)
              logoSources.push(`https://logo.clearbit.com/${domain}`);
              logoSources.push(`https://logo.clearbit.com/${domain}?size=128`);
              logoSources.push(`https://logo.clearbit.com/${domain}?size=256`);
              
              // 4. Google Favicon API (zuverlässige Alternative)
              logoSources.push(`https://www.google.com/s2/favicons?domain=${domain}&sz=128`);
              logoSources.push(`https://www.google.com/s2/favicons?domain=${domain}&sz=256`);
              
              // 5. Simple Icons CDN (für bekannte Tools)
              const simpleIconsMap = {
                'openai.com': 'openai',
                'anthropic.com': 'anthropic',
                'google.com': 'google',
                'github.com': 'github',
                'stripe.com': 'stripe',
                'vercel.com': 'vercel',
                'notion.so': 'notion',
                'airtable.com': 'airtable',
                'supabase.com': 'supabase',
                'zapier.com': 'zapier',
                'make.com': 'make',
                'n8n.io': 'n8n',
                'canva.com': 'canva',
                'framer.com': 'framer',
                'webflow.com': 'webflow',
                'bubble.io': 'bubble',
                'clickup.com': 'clickup',
                'monday.com': 'monday',
                'asana.com': 'asana',
                'hubspot.com': 'hubspot',
                'pipedrive.com': 'pipedrive',
                'typeform.com': 'typeform',
                'calendly.com': 'calendly',
                'loom.com': 'loom',
                'mailchimp.com': 'mailchimp',
                'sendgrid.com': 'sendgrid',
                'grammarly.com': 'grammarly',
                'semrush.com': 'semrush',
                'ahrefs.com': 'ahrefs',
                'unsplash.com': 'unsplash',
                'pexels.com': 'pexels',
                'binance.com': 'binance',
                'hostinger.com': 'hostinger',
                'huggingface.co': 'huggingface',
                'langchain.com': 'langchain',
                'pinecone.io': 'pinecone',
                'sourcegraph.com': 'sourcegraph',
                'tabnine.com': 'tabnine',
                'cloudflare.com': 'cloudflare',
                'docker.com': 'docker',
                'slack.com': 'slack',
                'discord.com': 'discord',
                'x.ai': 'x',
                'cursor.sh': 'cursor',
                'firecrawl.dev': 'firecrawl',
                'gamma.app': 'gamma',
                'greta.ai': 'greta',
                'headlime.com': 'headlime',
                'nocodebackend.com': 'nocodebackend',
                'skillplate.io': 'skillplate',
                'unmixr.ai': 'unmixr',
                'yapper.so': 'yapper',
              };
              
              if (simpleIconsMap[domain]) {
                logoSources.push(`https://cdn.simpleicons.org/${simpleIconsMap[domain]}`);
              }
            } else {
              logoSources.push(logoUrl);
            }
            
            let currentSourceIndex = 0;
            let logoLoaded = false;
            
            function tryNextSource() {
              if (currentSourceIndex < logoSources.length && !logoLoaded) {
                img.src = logoSources[currentSourceIndex];
                currentSourceIndex++;
              } else if (!logoLoaded) {
                console.error(`❌ Alle ${logoSources.length} Logo-Versuche fehlgeschlagen für: ${toolName}`);
                iconDiv.textContent = emoji;
              }
            }
            
            img.onload = function() {
              if (!logoLoaded) {
                logoLoaded = true;
                console.log(`✅ Logo geladen für ${toolName} (${currentSourceIndex}/${logoSources.length}): ${img.src}`);
                iconDiv.innerHTML = '';
                iconDiv.appendChild(img);
                img.style.display = 'block';
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.objectFit = 'cover'; // Logo füllt den Rahmen komplett
                img.style.padding = '0'; // Kein Padding
              }
            };
            
            img.onerror = function() {
              if (!logoLoaded) {
                // Nur bei ersten paar Versuchen loggen, um Console nicht zu überladen
                if (currentSourceIndex <= 3) {
                  console.warn(`⚠️ Logo-Versuch ${currentSourceIndex} fehlgeschlagen für ${toolName}`);
                }
                tryNextSource();
              }
            };
            
            // Starte Logo-Laden
            iconDiv.appendChild(img);
            tryNextSource();
          } else {
            // Keine URL gefunden, behalte Emoji
            iconDiv.textContent = emoji;
          }
        }
      });
    }

    // Track all affiliate links on page load
    document.addEventListener('DOMContentLoaded', function() {
      // Lade Tool-Logos
      loadToolLogos();
      
      // Sortiere Tools nach Name beim Laden (Standard)
      sortTools('name', false);
      
      // Track affiliate links
      document.querySelectorAll('[data-affiliate]').forEach(link => {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          const affiliateId = this.dataset.affiliate;
          trackAffiliate(affiliateId);
        });
      });
    });
  </script>
</body>
</html>
