<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KI & Tech Tools | Marktplatz | CanGo Empire</title>
  <meta name="description" content="Die besten KI-Tools für deine Automation-Workflows. OpenAI, Claude, Perplexity, BrowserAct, NeuronWriter und mehr - getestet und integriert in unsere n8n Workflows.">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="../cango-empire-v4-monopoly.css">
  
  <style>
    .marktplatz-page {
      padding: var(--space-20) 0 var(--space-12);
    }
    
    .marktplatz-header {
      text-align: center;
      margin-bottom: var(--space-16);
    }
    
    .marktplatz-header__icon {
      font-size: 4rem;
      margin-bottom: var(--space-4);
    }
    
    .tools-intro {
      text-align: center;
      max-width: 800px;
      margin: 0 auto var(--space-12);
      padding: var(--space-8);
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.05) 0%, rgba(249, 115, 22, 0.02) 100%);
      border: 1px solid rgba(249, 115, 22, 0.15);
      border-radius: var(--radius-lg);
    }
    
    .tools-intro p {
      color: var(--text-secondary);
      font-size: var(--text-base);
      line-height: 1.7;
      margin: var(--space-4) 0 0;
    }
    
    .tools-container {
      max-height: 80vh;
      overflow-y: auto;
      padding: var(--space-6);
      margin-top: var(--space-8);
      border-radius: var(--radius-lg);
      background: rgba(249, 115, 22, 0.01);
      border: 1px solid rgba(249, 115, 22, 0.1);
    }
    
    .tools-container::-webkit-scrollbar {
      width: 10px;
    }
    
    .tools-container::-webkit-scrollbar-track {
      background: rgba(249, 115, 22, 0.05);
      border-radius: 5px;
      margin: var(--space-2) 0;
    }
    
    .tools-container::-webkit-scrollbar-thumb {
      background: rgba(249, 115, 22, 0.3);
      border-radius: 5px;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    
    .tools-container::-webkit-scrollbar-thumb:hover {
      background: var(--primary-500);
      background-clip: padding-box;
    }
    
    .tool-card[data-category] {
      display: block;
    }
    
    .tool-card.hidden {
      display: none;
    }
    
    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: var(--space-6);
    }
    
    .tool-card {
      position: relative;
      padding: var(--space-6);
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.03) 0%, rgba(249, 115, 22, 0.01) 100%);
      border: 2px solid rgba(249, 115, 22, 0.15);
      border-radius: var(--radius-lg);
      transition: all var(--duration-slow) var(--ease-out);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    
    .tool-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--primary-500);
      opacity: 0;
      transition: opacity var(--duration-base) var(--ease-out);
    }
    
    .tool-card:hover {
      border-color: var(--primary-500);
      background: linear-gradient(135deg, rgba(249, 115, 22, 0.08) 0%, rgba(249, 115, 22, 0.03) 100%);
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(249, 115, 22, 0.15);
    }
    
    .tool-card:hover::before {
      opacity: 1;
    }
    
    .tool-card__header {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
    }
    
    .tool-card__icon {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #E5E7EB; /* Hellgrauer Hintergrund für transparente Logos */
      border: 1px solid rgba(249, 115, 22, 0.4); /* Dezente, dünne orange Linie */
      border-radius: var(--radius-md);
      font-size: 0; /* Verstecke Text/Emoji-Inhalt */
      line-height: 0; /* Verstecke Text/Emoji-Inhalt */
      flex-shrink: 0;
      transition: all var(--duration-base) var(--ease-out);
      overflow: hidden;
      position: relative;
    }
    
    /* Verstecke leere Icons sofort - kein Flackern */
    .tool-card__icon:empty {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    
    .tool-card__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain; /* Logo passt in den Rahmen */
      padding: var(--space-2); /* Padding für bessere Darstellung */
      border-radius: var(--radius-md);
      background: transparent;
      display: block !important; /* Stelle sicher, dass das Logo angezeigt wird */
      font-size: initial; /* Reset font-size für img */
      opacity: 1 !important;
      visibility: visible !important;
    }
    
    /* Verstecke alle Text-Knoten in Icons (Browser-kompatibel) */
    .tool-card__icon > *:not(img) {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
    }
    
    .tool-card:hover .tool-card__icon {
      background: #D1D5DB; /* Etwas dunkleres Grau beim Hover */
      border-color: rgba(249, 115, 22, 0.6); /* Etwas kräftigerer orange Rahmen beim Hover */
      transform: scale(1.05);
    }
    
    .tool-card:hover .tool-card__icon img {
      transform: scale(1);
    }
    
    .tool-card__title-group {
      flex: 1;
    }
    
    .tool-card__badge {
      display: inline-block;
      padding: var(--space-1) var(--space-2);
      background: rgba(249, 115, 22, 0.15);
      border: 1px solid rgba(249, 115, 22, 0.3);
      border-radius: var(--radius-sm);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--primary-400);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-family: 'JetBrains Mono', monospace;
      margin-bottom: var(--space-2);
    }
    
    .tool-card__name {
      font-size: var(--text-lg);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-2);
      letter-spacing: -0.01em;
    }
    
    .tool-card__description {
      font-size: var(--text-sm);
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: var(--space-4);
      flex: 1;
    }
    
    .tool-card__features {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    
    .tool-card__feature {
      font-size: var(--text-xs);
      color: var(--text-muted);
      padding-left: var(--space-4);
      position: relative;
    }
    
    .tool-card__feature::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--primary-400);
      font-weight: 700;
    }
    
    .tool-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid rgba(249, 115, 22, 0.1);
    }
    
    .tool-card__footer .tool-card__cta {
      flex-shrink: 0;
    }
    
    .tool-card__price {
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--primary-400);
      font-family: 'JetBrains Mono', monospace;
      white-space: nowrap;
    }
    
    .tool-card__cta {
      padding: var(--space-3) var(--space-6);
      background: var(--primary-500);
      color: var(--text-primary);
      border: none;
      border-radius: var(--radius-md);
      font-size: var(--text-sm);
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      transition: all var(--duration-base) var(--ease-out);
      cursor: pointer;
      min-width: 120px;
      white-space: nowrap;
    }
    
    .tool-card__cta:hover {
      background: var(--primary-600);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
    }
    
    .tool-card__affiliate-badge {
      font-size: var(--text-xs);
      color: var(--text-muted);
      font-style: italic;
      margin-top: var(--space-2);
    }
    
    @media (max-width: 768px) {
      .tools-grid {
        grid-template-columns: 1fr;
      }
      
      .tool-card__footer {
        flex-direction: column;
        align-items: stretch;
      }
      
      .tool-card__cta {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <nav class="nav" role="navigation" aria-label="Hauptnavigation">
    <div class="container nav__inner">
      <a href="../cango-empire-v4-monopoly.html" class="nav__brand">
        <span class="nav__brand-icon">C</span>
        <span>CanGo Empire</span>
      </a>
      
      <button class="nav__toggle" aria-label="Menü öffnen" onclick="document.querySelector('.nav__menu').classList.toggle('active')">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="nav__menu">
        <a href="../cango-empire-v4-monopoly.html#problem" class="nav__link">Problem</a>
        <a href="../cango-empire-v4-monopoly.html#technologie" class="nav__link">Technologie</a>
