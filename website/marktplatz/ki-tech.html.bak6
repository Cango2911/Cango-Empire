  <section class="marktplatz-page">
    <div class="container">
      <div class="marktplatz-header">
        <div class="marktplatz-header__icon">🤖</div>
        <span class="section__eyebrow" style="display: inline-block; font-size: var(--text-sm); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--primary-400); margin-bottom: var(--space-4); font-family: 'JetBrains Mono', monospace;">
          KI & TECH TOOLS
        </span>
        <h1 style="font-size: clamp(2.5rem, 5vw, var(--text-5xl)); margin-bottom: var(--space-4); font-weight: 700; line-height: 1.1; color: var(--text-primary);">
          Die besten <span class="text-gradient">KI-Tools</span> für deine Automation
        </h1>
        <p style="font-size: var(--text-lg); color: var(--text-secondary); max-width: 700px; margin: 0 auto;">
          Getestet, integriert und täglich eingesetzt in unseren n8n Workflows. Alle Tools sind Affiliate-Partner und unterstützen unsere Infrastruktur.
        </p>
      </div>

      <div class="tools-intro">
        <p>
          <strong style="color: var(--primary-400);">Wichtig:</strong> Diese Tools sind alle in unseren 33 Master-Workflows integriert. 
          Über unsere Affiliate-Links erhältst du Zugang zu den besten Deals (inkl. AppSumo Lifetime-Deals) und unterstützt gleichzeitig unsere Infrastruktur.
        </p>
      </div>

      <!-- Suchleiste -->
      <div class="tools-search" style="max-width: 600px; margin: 0 auto var(--space-8);">
        <input 
          type="text" 
          id="toolSearch" 
          placeholder="🔍 Tools durchsuchen..." 
          oninput="searchTools(this.value)"
          style="width: 100%; padding: var(--space-3) var(--space-4); background: rgba(249, 115, 22, 0.05); border: 2px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-lg); color: var(--text-primary); font-size: var(--text-base); font-family: 'Instrument Sans', sans-serif; transition: all 0.3s; outline: none;"
          onfocus="this.style.borderColor='var(--primary-500)'; this.style.background='rgba(249, 115, 22, 0.08)';"
          onblur="this.style.borderColor='rgba(249, 115, 22, 0.2)'; this.style.background='rgba(249, 115, 22, 0.05)';"
        />
      </div>

      <!-- Tool Categories Navigation + Sortierung -->
      <div class="tools-filter" style="display: flex; justify-content: center; align-items: center; gap: var(--space-3); margin-bottom: var(--space-8); flex-wrap: wrap; position: relative;">
        <button class="filter-btn active" data-category="all" onclick="filterTools('all')" style="padding: var(--space-2) var(--space-4); background: rgba(249, 115, 22, 0.1); border: 1px solid rgba(249, 115, 22, 0.3); border-radius: var(--radius-md); color: var(--primary-400); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s;">Alle (100+)</button>
        <button class="filter-btn" data-category="lifetime" onclick="filterTools('lifetime')" style="padding: var(--space-2) var(--space-4); background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s;">⭐ Lifetime Lizenzen</button>
        <button class="filter-btn" data-category="intelligence" onclick="filterTools('intelligence')" style="padding: var(--space-2) var(--space-4); background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s;">AI Intelligence</button>
        <button class="filter-btn" data-category="automation" onclick="filterTools('automation')" style="padding: var(--space-2) var(--space-4); background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s;">Automation</button>
        <button class="filter-btn" data-category="visual" onclick="filterTools('visual')" style="padding: var(--space-2) var(--space-4); background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s;">Visual & Media</button>
        <button class="filter-btn" data-category="content" onclick="filterTools('content')" style="padding: var(--space-2) var(--space-4); background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s;">SEO & Content</button>
        <button class="filter-btn" data-category="research" onclick="filterTools('research')" style="padding: var(--space-2) var(--space-4); background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s;">Research</button>
        
        <!-- Sortierung Dropdown -->
        <div class="tools-sort-wrapper" style="position: relative;">
          <button 
            id="sortDropdownBtn" 
            onclick="toggleSortDropdown()"
            style="display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1); padding: var(--space-2) var(--space-3); background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 600; cursor: pointer; transition: all 0.3s; font-family: 'Instrument Sans', sans-serif; min-width: auto;"
            onmouseover="this.style.background='rgba(249, 115, 22, 0.1)'; this.style.borderColor='rgba(249, 115, 22, 0.3)'; this.style.color='var(--primary-400)';"
            onmouseout="this.style.background='rgba(249, 115, 22, 0.05)'; this.style.borderColor='rgba(249, 115, 22, 0.2)'; this.style.color='var(--text-secondary)';"
          >
            <span>🔽</span>
          </button>
        
          <div id="sortDropdown" class="sort-dropdown" style="display: none; position: absolute; top: calc(100% + var(--space-2)); right: 0; background: var(--bg-elevated); border: 2px solid rgba(249, 115, 22, 0.3); border-radius: var(--radius-lg); padding: var(--space-2); min-width: 220px; z-index: 1000; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3); backdrop-filter: blur(10px);">
          <button 
            class="sort-option" 
            data-sort="name" 
            onclick="selectSort('name', 'A-Z')"
            style="width: 100%; padding: var(--space-3) var(--space-4); background: transparent; border: none; border-radius: var(--radius-md); color: var(--text-primary); font-size: var(--text-sm); font-weight: 500; cursor: pointer; text-align: left; transition: all 0.2s; font-family: 'Instrument Sans', sans-serif;"
            onmouseover="this.style.background='rgba(249, 115, 22, 0.1)';"
            onmouseout="this.style.background='transparent';"
          >
            📝 A-Z
          </button>
          <button 
            class="sort-option" 
            data-sort="price-asc" 
            onclick="selectSort('price-asc', 'Preis aufsteigend')"
            style="width: 100%; padding: var(--space-3) var(--space-4); background: transparent; border: none; border-radius: var(--radius-md); color: var(--text-primary); font-size: var(--text-sm); font-weight: 500; cursor: pointer; text-align: left; transition: all 0.2s; font-family: 'Instrument Sans', sans-serif;"
            onmouseover="this.style.background='rgba(249, 115, 22, 0.1)';"
            onmouseout="this.style.background='transparent';"
          >
            💰 Preis aufsteigend
          </button>
          <button 
            class="sort-option" 
            data-sort="price-desc" 
            onclick="selectSort('price-desc', 'Preis absteigend')"
            style="width: 100%; padding: var(--space-3) var(--space-4); background: transparent; border: none; border-radius: var(--radius-md); color: var(--text-primary); font-size: var(--text-sm); font-weight: 500; cursor: pointer; text-align: left; transition: all 0.2s; font-family: 'Instrument Sans', sans-serif;"
            onmouseover="this.style.background='rgba(249, 115, 22, 0.1)';"
            onmouseout="this.style.background='transparent';"
          >
            💰 Preis absteigend
          </button>
          <button 
            class="sort-option" 
            data-sort="popularity" 
            onclick="selectSort('popularity', 'Beliebte Produkte')"
            style="width: 100%; padding: var(--space-3) var(--space-4); background: transparent; border: none; border-radius: var(--radius-md); color: var(--text-primary); font-size: var(--text-sm); font-weight: 500; cursor: pointer; text-align: left; transition: all 0.2s; font-family: 'Instrument Sans', sans-serif;"
            onmouseover="this.style.background='rgba(249, 115, 22, 0.1)';"
            onmouseout="this.style.background='transparent';"
          >
            ⭐ Beliebte Produkte
          </button>
          </div>
        </div>
      </div>

      <div class="tools-container" id="toolsContainer" style="max-height: 80vh; overflow-y: auto; padding-right: var(--space-4); margin-top: var(--space-12); border-radius: var(--radius-lg); background: rgba(249, 115, 22, 0.01); border: 1px solid rgba(249, 115, 22, 0.1);">
        <div class="tools-grid" id="toolsGrid" data-category="all">
        
        <!-- OpenAI / ChatGPT -->
        <div class="tool-card" data-category="intelligence">
          <div class="tool-card__header">
            <div class="tool-card__icon"><img src="https://cdn.simpleicons.org/openai/10A37F" alt="OpenAI" /></div>
            <div class="tool-card__title-group">
              <span class="tool-card__badge">MARKET LEADER</span>
              <h3 class="tool-card__name">ChatGPT / OpenAI</h3>
            </div>
          </div>
          <p class="tool-card__description">
            GPT-4o für Datenanalyse, Vision-Tasks und Content-Generierung. Der Allrounder unserer Workflows.
          </p>
          <ul class="tool-card__features">
            <li class="tool-card__feature">GPT-4o für komplexe Aufgaben</li>
            <li class="tool-card__feature">Vision API für Bildanalyse</li>
            <li class="tool-card__feature">DALL-E 3 für Image-Generation</li>
            <li class="tool-card__feature">Perfekte n8n Integration</li>
          </ul>
          <div class="tool-card__footer">
            <div class="tool-card__price">ab 20$ / Monat</div>
            <a href="tools/chatgpt-plus.html" class="tool-card__cta" data-affiliate="openai" onclick="trackAffiliate('openai');">
              Zum Tool →
            </a>
          </div>
        </div>

        <!-- Anthropic Claude -->
        <div class="tool-card" data-category="intelligence">
          <div class="tool-card__header">
            <div class="tool-card__icon"><img src="https://cdn.simpleicons.org/anthropic/D4A574" alt="Anthropic Claude" /></div>
            <div class="tool-card__title-group">
              <span class="tool-card__badge">CODING KING</span>
              <h3 class="tool-card__name">Claude 3.5 Sonnet</h3>
            </div>
          </div>
          <p class="tool-card__description">
            Das Gehirn unserer Python-Skripte. Schreibt besseren Code als GPT-4 und ist essentiell für unsere Automation-Workflows.
          </p>
          <ul class="tool-card__features">
            <li class="tool-card__feature">Überlegene Code-Qualität</li>
            <li class="tool-card__feature">200K Token Context</li>
            <li class="tool-card__feature">Perfekte API-Integration</li>
            <li class="tool-card__feature">Premium Support inklusive</li>
          </ul>
          <div class="tool-card__footer">
            <div class="tool-card__price">ab 20$ / Monat</div>
            <a href="tools/claude-35.html" class="tool-card__cta" data-affiliate="claude" onclick="trackAffiliate('claude')">
              Zum Tool →
            </a>
          </div>
        </div>

        <!-- Perplexity Pro -->
        <div class="tool-card" data-category="research">
          <div class="tool-card__header">
            <div class="tool-card__icon"><img src="https://cdn.simpleicons.org/perplexity/AA8FFF" alt="Perplexity" /></div>
            <div class="tool-card__title-group">
              <span class="tool-card__badge">RESEARCH</span>
              <h3 class="tool-card__name">Perplexity Pro</h3>
            </div>
          </div>
          <p class="tool-card__description">
            Echtzeit-Websuche mit Quellen. Ersetzt Google für Business-Research. Unser Layer 1 für Faktenverifikation.
          </p>
          <ul class="tool-card__features">
